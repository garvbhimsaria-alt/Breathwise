# BreatheWise Backend Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to Git.

# Primary Provider: CPCB via data.gov.in
# Register at https://data.gov.in and generate a free API key.
DATA_GOV_IN_API_KEY=

# Secondary Provider: OpenAQ v3
# Register at https://openaq.org and generate a free API key.
OPENAQ_API_KEY=

# Server Configuration (optional overrides)
PORT=5000
